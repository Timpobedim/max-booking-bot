# Токен бота MAX (выдаётся при создании бота на платформе MAX для партнёров)
TYRE_BOT_MAX_TOKEN=
# Чат мастеров: сюда приходят новые записи и отмены (chat_id; пусто — без уведомлений)
TYRE_BOT_ADMIN_CHAT_ID=
TYRE_BOT_DATABASE=data/bookings.sqlite3
# Сколько машин обслуживается одновременно и часы работы
TYRE_BOT_POSTS=2
TYRE_BOT_OPENS=09:00
TYRE_BOT_CLOSES=20:00
TYRE_BOT_DAYS_AHEAD=7
TYRE_BOT_TIMEZONE=Europe/Moscow
